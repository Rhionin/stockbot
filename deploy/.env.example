# Stockbot Deployment Configuration
#
# Copy this file to .env and customize the values below.
# Docker Compose will automatically load .env from this directory.

# Container image tag to deploy (default: latest)
# Use 'latest' for the most recent build, 'main' for the main branch, or a full commit SHA to pin to a specific version
PANTRY_IMAGE_TAG=latest

# Host port for loopback probes (default: 8080). Compose publishes it on
# 127.0.0.1 only. The container listens on 8080. Caddy reaches it as
# pantry:8080 on the compose network. Do not open this port on Wi-Fi.
HOST_PORT=8080

# Public origin for invite and reset links, the Origin check, and the
# Expo server. On the Pi set https://stockbot.rhionin.com with no path.
# The host must match PUBLIC_HOST. A rename is this value plus DNS.
APP_BASE_URL=

# Name shown in the product title and alert fallback. A rename is this value.
APP_NAME=Stockbot

# Personal-session cookie. The __Host- prefix is host-only. If COOKIE_DOMAIN
# is set, that prefix is dropped because it cannot carry a Domain attribute.
# Leave COOKIE_DOMAIN empty unless a later hostname should share the cookie
# (for example an HTTPS name on the LAN).
SESSION_COOKIE_NAME=__Host-stockbot_session
COOKIE_DOMAIN=

# Empty until a mailer exists.
EMAIL_FROM=

# Oldest Expo build this server will accept (GET /api/config and the 426 gate).
EXPO_MIN_VERSION=1.0.0

# Public hostname for HTTPS, such as stockbot.rhionin.com.
# Leave empty to stay LAN-only. When set, `sudo ./setup.sh` starts the public
# proxy when ACME_EMAIL is also set (certificate mode), or Cloudflare Tunnel
# when CLOUDFLARE_TUNNEL_TOKEN is set.
# Do not include https:// — hostname only.
PUBLIC_HOST=

# Previous public hostname that should redirect to PUBLIC_HOST, such as
# pantry.rhionin.com while PUBLIC_HOST is stockbot.rhionin.com.
# Leave empty to serve PUBLIC_HOST only. Hostname only, no https://.
# sudo ./setup.sh writes the redirect. It does not change PUBLIC_HOST.
LEGACY_PUBLIC_HOST=

# acme (or empty) obtains a Let's Encrypt certificate when PUBLIC_HOST is set
# and CLOUDFLARE_TUNNEL_TOKEN is empty. tunnel selects Cloudflare Tunnel, and
# still requires the token. A non-empty token selects tunnel on its own.
PUBLISH_MODE=

# Remotely managed token for the existing tunnel pantry-pi
# (Zero Trust → Networks → Tunnels). Empty keeps Let's Encrypt, the
# Gryphon forwards, and the Dynu update client. setup.sh does not call Dynu.
# This is a secret. Do not commit it, and do not wrap it in quotes.
# The public hostname's service URL is http://caddy:80
CLOUDFLARE_TUNNEL_TOKEN=

# Email Let's Encrypt uses for certificate expiry notices.
# Required when PUBLIC_HOST is set and CLOUDFLARE_TUNNEL_TOKEN is empty.
# Not used in tunnel mode. Not a Stockbot login.
ACME_EMAIL=

# Session secret for the public login cookie. setup.sh and the update timer
# fill this in once when PUBLIC_HOST is set, and never replace it.
# Leave it empty until then. Rotating it signs every phone out.
PANTRY_SESSION_SECRET=

# Web Push identity for scan alerts that arrive while Stockbot is closed.
# setup.sh fills the keys once when either one is empty, and does not
# replace a pair you already set. The private key is a secret. Do not
# commit it. VAPID_SUBJECT is a contact, mailto: or https://. Empty lets
# setup fill mailto:pantry@PUBLIC_HOST, or mailto:pantry@localhost when
# PUBLIC_HOST is empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Product cache TTL - how long to cache product lookups (default: 720h = 30 days)
# Examples: 24h, 168h (1 week), 720h (30 days), 8760h (1 year)
PRODUCT_CACHE_TTL=720h

# Product miss TTL - how long to cache "not found" results (default: 168h = 7 days)
# Examples: 24h, 168h (1 week), 30m (30 minutes for testing)
PRODUCT_MISS_TTL=168h

# Disable external product lookups (default: false)
# Set to 'true' to disable external API calls for product information.
# This also keeps product contribution local, even if an account is set below.
DISABLE_EXTERNAL_PRODUCT_LOOKUP=false

# Live store prices during cart building (optional).
# Leave the key empty until a retailer adapter and credentials exist.
# A key alone does not fetch prices. Sales noted in the app still apply.
PANTRY_RETAILER_API_KEY=
PANTRY_RETAILER_API_URL=

# Optional account for contributing products a person explicitly opts in to share.
# Leave both unset unless you have created a dedicated account. Each Product
# Opener database (Open Food Facts, Open Products Facts, Open Beauty Facts,
# Open Pet Food Facts) has its own users, so one account may only succeed on
# the site where it was created. Never commit a real password.
# PRODUCT_OPENER_USER_ID=
# PRODUCT_OPENER_PASSWORD=

# Control barcode for stock-in operations (default: STOCK_IN)
# Scan this barcode to switch the scanner to "stock in" mode
STOCK_IN_CONTROL_BARCODE=STOCK_IN

# Control barcode for stock-out operations (default: STOCK_OUT)
# Scan this barcode to switch the scanner to "stock out" mode
STOCK_OUT_CONTROL_BARCODE=STOCK_OUT

# User ID for headless scan operations (default: user-1)
# This identifies the user when scans are processed without a logged-in session
HEADLESS_USER_ID=user-1

# Scan input source (default: device)
# Set to 'stdin' for local development (type barcodes into terminal)
# Keep as 'device' for Raspberry Pi with a USB scanner
SCAN_INPUT=device

# Scanner device path (default: /dev/input/pantry-scanner)
# This should match the udev symlink created by 99-pantry-scanner.rules.
# The symlink MUST live under /dev/input because the container bind-mounts that
# directory (not a single node). A relative symlink created by udev will not resolve
# outside that directory.
#
# Debugging escape hatch: point directly at a concrete /dev/input/eventN to isolate
# udev problems from container problems. Example: SCANNER_DEVICE=/dev/input/event3
SCANNER_DEVICE=/dev/input/pantry-scanner

# Shared secret for POST /api/deploy-hook. setup.sh fills this in when it
# is empty and does not replace a value you already set. Put the same value
# in the GitHub Actions secret DEPLOY_HOOK_SECRET. Print it with:
#   sudo ./setup.sh deploy-secret
# The hook is what deploys an image as soon as it is pushed. The update
# timer still pulls every minute when the hook is not configured.
DEPLOY_HOOK_SECRET=

# Back up pantry.db before recreating the pantry container when its image
# digest changes. required (the default) stops the deploy before recreate when
# the backup fails and writes last-deploy-status. warn or optional logs a
# failure and continues. off skips the backup. An unchanged digest does not
# take one.
BACKUP_BEFORE_DEPLOY=required

# One-way copy of this pantry into a Grocy container on the same Pi.
# grocy-sync is Compose profile grocy-sync. Setup does not start it, and
# profile grocy does not start it. The API key is created in
# Grocy (user menu → manage API keys) and lives only in this file.
# PANTRY_SYNC_TOKEN is a separate read-only secret for the sidecar.
# Generate one with: openssl rand -hex 32
# TZ should match the Grocy container. See README.md, "Grocy sync".
GROCY_URL=
GROCY_API_KEY=
PANTRY_SYNC_TOKEN=
GROCY_SYNC_INTERVAL=5m
# TZ=

# Error reporting. Leave SENTRY_DSN empty to keep it off: the process
# makes no error-reporting calls. SENTRY_ENVIRONMENT is optional and
# defaults to production when SENTRY_DSN is set. SENTRY_TUNNEL_PROJECT_IDS
# is a comma-separated list of project ids the browser tunnel may forward.
# Empty leaves POST /api/sentry-tunnel hidden. SENTRY_TUNNEL_PUBLIC_KEYS is
# an optional comma-separated list of DSN public keys. Empty does not check
# the key. These values stay in this file on the Pi. Do not commit them.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TUNNEL_PROJECT_IDS=
SENTRY_TUNNEL_PUBLIC_KEYS=

# Scanner group ID (default: 65532)
# The numeric gid of the "pantry" group that the container process runs as
# This allows read access to /dev/pantry-scanner without running as root
# Get with: getent group pantry | cut -d: -f3
SCANNER_GID=65532
