# Public HTTPS entrypoint for a hostname you own (PUBLIC_HOST).
# Caddy obtains and renews a Let's Encrypt certificate over HTTP-01,
# which requires TCP port 80 to reach this container from the internet.
# The admin API stays off so it is not another listener on the Pi.
#
# Home Wi-Fi clients that look up PUBLIC_HOST get the router's WAN address.
# If that router does not NAT-hairpin, the connection hangs and never
# reaches this process. Do not publish port 8080 to paper over that: the
# Stockbot listener has no password. Those clients use http://<lan-ip>:8080
# or http://pantry.local:8080. See deploy/README.md.
# Caddyfile.tunnel is the no-forward path. setup selects it when
# CLOUDFLARE_TUNNEL_TOKEN is set. This file stays the certificate path.
{
	email {$ACME_EMAIL}
	admin off
}

# Same browser headers on the public paths and on the password-protected site.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self'"
		-Server
	}
}

# Previous public name. setup.sh rewrites Caddyfile.legacy when
# LEGACY_PUBLIC_HOST is set. A comment-only file serves PUBLIC_HOST only.
import Caddyfile.legacy

{$PUBLIC_HOST} {
	# 1 MB covers every handle in this site: telemetry, the build
	# identity, the deploy hook, and the public catch-all, which is
	# where POST /api/sentry-tunnel stays. The app accepts 4 KiB on
	# POST /api/telemetry/client and 256 KiB on the Sentry tunnel, so
	# both fit under this cap and neither handle needs its own.
	request_body {
		max_size 1MB
	}

	# handle is first-match. This matcher is exact: /api/telemetry and
	# /api/telemetry/client only. The snapshot has no barcodes, product names,
	# or user ids, and the page posts timings here, so both stay reachable
	# without the household password. Do not add other API paths to this matcher.
	@telemetry path /api/telemetry /api/telemetry/client
	handle @telemetry {
		route {
			import security_headers
			encode gzip
			reverse_proxy pantry:8080
		}
	}

	# Exact path: /api/build only. The JSON is the running commit, the commit
	# time, the image build time, a version tag, and the subject. None of
	# those are secrets. Keep this handle with telemetry and the deploy hook,
	# before the household site. Like those handles, this proxy does not set
	# X-Pantry-Entry or X-Pantry-Client-IP; the catch-all below is what marks
	# the public site. The app also leaves this path open when that header
	# is present. Do not add other API paths to this matcher.
	@build path /api/build
	handle @build {
		route {
			import security_headers
			encode gzip
			reverse_proxy pantry:8080
		}
	}

	# Exact URLs a grocery developer app stores permanently: the brand mark,
	# terms of use, and privacy policy. path is exact, so /brand/logo.png
	# does not open /brand/ and /terms does not open /terms/anything.
	# This is not an API exception. Do not add /api paths here, and do not
	# replace these three with a prefix.
	@public path /brand/logo.png /terms /privacy
	handle @public {
		route {
			import security_headers
			encode gzip
			reverse_proxy pantry:8080
		}
	}

	# GitHub Actions POSTs here after the image push. The household password
	# is not used: the caller is the workflow, and this Pi has no inbound
	# port. The app checks an HMAC and a timestamp, and rejects anything else.
	# Do not add other API paths to this matcher.
	@deploy path /api/deploy-hook
	handle @deploy {
		route {
			import security_headers
			encode gzip
			reverse_proxy pantry:8080
		}
	}

	# Device scan, heartbeat, and token rotation. These posts are small
	# JSON. 64 KB is tighter than the site cap. The proxy headers match
	# the public site, so the app still sees the visitor address.
	# /api/devices (pairing) is not this prefix.
	handle /api/device/* {
		request_body {
			max_size 64KB
		}
		route {
			import security_headers
			encode gzip
			reverse_proxy pantry:8080 {
				header_up X-Pantry-Entry public
				header_up X-Pantry-Client-IP {client_ip}
			}
		}
	}

	# Everything else is the household site. Caddy does not show a password
	# prompt. Stockbot asks for the same username and password when it sees
	# X-Pantry-Entry, and the handles above stay open. header_up replaces a
	# value supplied by the client, so the LAN port cannot be made to look
	# like the public site by omitting the header on the way through Caddy.
	# POST /api/sentry-tunnel is answered before the household password so a
	# login page can report a failure. It stays in this handle, which is what
	# stamps the visitor address. Do not move it to a handle above.
	handle {
		route {
			import security_headers

			# Scan and inventory pages keep a Server-Sent Events stream open on
			# /api/events. Buffering or compressing that response holds events
			# until the stream ends, so the UI never updates live.
			@events path /api/events
			handle @events {
				reverse_proxy pantry:8080 {
					flush_interval -1
					header_up X-Pantry-Entry public
					header_up X-Pantry-Client-IP {client_ip}
				}
			}

			# /sw.js is the scan-alert service worker. Its scope is the site
			# root, so the file has to be this exact path. Leave it
			# uncompressed: Android Firefox has failed to install a gzipped
			# worker. Do not set Cache-Control or Service-Worker-Allowed
			# here. Stockbot already sends each of those once, and a second
			# copy is joined into a value the browser rejects. Subscribe and
			# unsubscribe stay on /api and use the household session cookie,
			# the same way the rest of the app does.
			@serviceworker path /sw.js
			handle @serviceworker {
				reverse_proxy pantry:8080 {
					header_up X-Pantry-Entry public
					header_up X-Pantry-Client-IP {client_ip}
				}
			}

			handle {
				encode gzip
				reverse_proxy pantry:8080 {
					header_up X-Pantry-Entry public
					header_up X-Pantry-Client-IP {client_ip}
				}
			}
		}
	}
}
